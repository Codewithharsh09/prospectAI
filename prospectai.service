[Unit]
Description=ProspectAI Flask Application
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/prospectai
Environment=FLASK_ENV=production
EnvironmentFile=/var/www/prospectai/.env
ExecStart=/var/www/prospectai/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prospectai

[Install]
WantedBy=multi-user.target
